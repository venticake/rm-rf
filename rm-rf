#!/usr/bin/env python3
"""A conservative, cache-aware disk cleanup console for macOS and Ubuntu.

It deliberately scans known cleanup locations rather than recursively scanning
the whole home directory.  Nothing is deleted without an explicit selection
and a typed confirmation.
"""

from __future__ import annotations

