{
  "version": 1,
  "platforms": {
    "Darwin": [
      {"pattern": "{home}/.Trash", "label": "Trash", "group": "Trash", "safety": "trash", "reason": "Files already in Trash"},
      {"pattern": "{home}/Library/Caches", "label": "Library cache", "group": "Caches", "safety": "cache", "reason": "Application caches"},
      {"pattern": "{home}/Library/Logs", "label": "Library logs", "group": "Logs", "safety": "rotated_log", "reason": "Application and diagnostic logs"},
      {"pattern": "{home}/Library/Developer/Xcode/DerivedData", "label": "Xcode DerivedData", "group": "Developer", "safety": "cache", "reason": "Xcode build products; regenerated by Xcode"},
      {"pattern": "{home}/Library/Developer/CoreSimulator/Caches", "label": "Simulator cache", "group": "Developer", "safety": "cache", "reason": "iOS Simulator caches; regenerated"},
      {"pattern": "{home}/Library/Developer/CoreSimulator/Devices/*/data/Library/Caches", "label": "Simulator app cache", "group": "Developer", "safety": "cache", "reason": "Per-simulator application cache; regenerated"},
      {"pattern": "{home}/Library/Containers/*/Data/Library/Caches", "label": "Sandbox app cache", "group": "Caches", "safety": "cache", "reason": "Per-application sandbox cache"},
      {"pattern": "{home}/Library/Group Containers/*/Library/Caches", "label": "Group container cache", "group": "Caches", "safety": "cache", "reason": "Shared application cache"},
      {"pattern": "{home}/Library/Application Support/CrashReporter", "label": "Crash reports", "group": "Logs", "safety": "rotated_log", "reason": "Crash reports used only for diagnostics"},
      {"pattern": "{home}/Library/Application Support/MobileSync/Backup", "label": "iPhone/iPad backup", "group": "Review", "safety": "review", "reason": "Personal device backups: inspect before deletion"},
      {"pattern": "/Library/Caches", "label": "System cache", "group": "System", "safety": "cache", "reason": "System-level caches; may require administrator permission", "requires_admin": true},
      {"pattern": "/Library/Logs", "label": "System application logs", "group": "System", "safety": "rotated_log", "reason": "Logs from installed applications; may require administrator permission", "requires_admin": true}
    ],
    "Linux": [
      {"pattern": "{home}/.local/share/Trash/files", "label": "Trash", "group": "Trash", "safety": "trash", "reason": "Files already in Trash"},
      {"pattern": "{xdg_cache_home}", "label": "Application cache", "group": "Caches", "safety": "cache", "reason": "XDG application caches"},
      {"pattern": "{home}/.var/app/*/cache", "label": "Flatpak app cache", "group": "Caches", "safety": "cache", "reason": "Flatpak application cache"},
      {"pattern": "{home}/.gradle/caches", "label": "Gradle cache", "group": "Developer", "safety": "cache", "reason": "Build dependency cache; recreated by Gradle"},
      {"pattern": "{home}/.cargo/registry/cache", "label": "Cargo crate archive cache", "group": "Developer", "safety": "cache", "reason": "Downloaded Cargo crate archives"},
      {"pattern": "{home}/.rustup/downloads", "label": "Rustup downloads", "group": "Developer", "safety": "cache", "reason": "Rust toolchain installer downloads"},
      {"pattern": "{home}/.m2/repository", "label": "Maven repository", "group": "Review", "safety": "review", "reason": "Downloaded dependencies; can be restored but may be costly"},
      {"pattern": "{home}/.nuget/packages", "label": "NuGet packages", "group": "Review", "safety": "review", "reason": "Downloaded packages; projects may need to restore them"},
      {"pattern": "{home}/.steam/steam/steamapps/shadercache", "label": "Steam shader cache", "group": "Caches", "safety": "cache", "reason": "Game shader cache; rebuilt when games launch"},
      {"pattern": "{home}/.local/share/Steam/steamapps/shadercache", "label": "Steam shader cache", "group": "Caches", "safety": "cache", "reason": "Game shader cache; rebuilt when games launch"},
      {"pattern": "/var/log", "label": "Rotated system logs", "group": "System", "safety": "rotated_log", "reason": "Only old rotated/compressed logs, not active logs", "mode": "rotated_logs", "requires_admin": true}
    ]
  },
  "special_targets": {
    "download_installer": {
      "pattern": "{home}/Downloads",
      "label": "Old installer/archive",
      "group": "Review",
      "safety": "review",
      "reason": "Old installer or archive in Downloads; inspect before deletion",
      "mode": "item"
    }
  }
}
